# Copy to .env.local (git ignored) and adjust. Used by the Vite dev server and build/install-foundry.sh.

# Foundry instance the dev server proxies to (default: http://localhost:30000, the docker compose setup)
FOUNDRY_URL=

# Foundry "Data/modules" directory the production build gets installed into by `npm run install:foundry`
FOUNDRY_MODULES_DIR=
