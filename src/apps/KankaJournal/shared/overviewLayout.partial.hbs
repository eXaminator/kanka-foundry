{{#>./layout}}
    {{#*inline 'content'~}}
        {{!-- <div class="kanka-overview-columns">
            {{#if data.system.img }}
            <div class="image-column">
                <img src="{{ data.system.img }}" alt="{{ data.name }}" />
            </div>
            {{/if}} --}}

            <table class="kanka-attributes">
                {{!-- Type specific Attributes --}}
                {{~#>attributes~}}{{~/attributes~}}

                {{!-- Status (alive, dead, destroyed, completed, ...) --}}
                {{~>./statusRow status=data.system.snapshot.status }}

                {{!-- Starred Relations --}}
                {{~#with (kankaFilterPinned (kankaFilterReferences data.system.snapshot.relations)) as | starred |~}}
                    {{~#each starred ~}}
                        {{~>./detailRow value=target_id rawLabel=relation reference=true isSecret=(kankaIsSecret this) }}
                    {{~/each~}}
                {{~/with~}}

                {{!-- Starred Attributes --}}
                {{~#with (kankaSortBy (kankaFilterPinned (kankaFilterAccessible data.system.snapshot.attributes)) 'default_order') as | starred |~}}
                    {{~#each starred ~}}
                        {{~>./attributeEntry attribute=this~}}
                    {{~/each~}}
                {{~/with~}}
            </table>
        {{!-- </div> --}}

        {{~#>content~}}{{~/content~}}
    {{~/inline}}
{{/./layout}}

